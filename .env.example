# ==========================================================
# PromoBox — exemplo de variáveis de ambiente
# Copie este arquivo para ".env" e preencha os valores reais.
# NUNCA commite o arquivo ".env" no Git.
# ==========================================================

# Geral
APP_NAME=PromoBox
TIMEZONE=America/Sao_Paulo
DEMO_MODE=true
SECRET_KEY=troque-por-uma-chave-aleatoria-longa
PASSWORD_SALT=troque-por-um-salt-aleatorio

# Banco de dados (padrão: SQLite local; em produção, use Postgres/MySQL)
DATABASE_URL=sqlite:///data/promobox.db

# Login administrativo inicial
ADMIN_USER=admin
# Gere o hash com: python -c "from app.components.auth import hash_password; print(hash_password('sua-senha'))"
ADMIN_PASSWORD_HASH=

# IA (opcional — se vazio, usa geração por template, sem chamada externa)
AI_PROVIDER=template
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# WhatsApp Business Platform (Cloud API) — canal principal do PromoBox
# https://developers.facebook.com/docs/whatsapp/cloud-api
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_APP_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
# Porta do servidor de webhook standalone (python webhook_server.py)
WEBHOOK_PORT=8090

# Telegram Bot API — https://core.telegram.org/bots/api
TELEGRAM_BOT_TOKEN=

# E-mail (SMTP)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Shopee Affiliate Open API (aguardando aprovação/credenciais)
SHOPEE_PARTNER_ID=
SHOPEE_PARTNER_KEY=

# Mercado Livre (OAuth2 + programa de Afiliados)
MERCADOLIVRE_CLIENT_ID=
MERCADOLIVRE_CLIENT_SECRET=

# Amazon PA-API 5.0 (Associados)
AMAZON_ACCESS_KEY=
AMAZON_SECRET_KEY=
AMAZON_PARTNER_TAG=

# Intervalo do worker standalone (minutos)
CYCLE_INTERVAL_MINUTES=5
